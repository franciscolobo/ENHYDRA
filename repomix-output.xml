        d = tmp_path / "alignment"
        d.mkdir()
        write_stage_marker(str(d), "alignment", {"aligner": "mafft"})
        assert list_data_files(str(d)) == []

    def test_does_not_filter_files_merely_containing_dots(self, tmp_path):
