            ("sp1|g1", 0.1, "sp2|g2"),
            ("sp2|g2", 0.95, "sp3|g3"), ("sp3|g3", 0.96, "sp2|g2"),
            ("sp4|g4", 0.94, "sp2|g2"), ("sp5|g5", 0.97, "sp2|g2"),
