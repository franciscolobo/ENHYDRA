            "list1 = pathogenic.txt\nlist2 = non_pathogenic.txt\n"
            "sources = GO:BP KEGG\n"
        )
        code = self._make_fh("")
        p = read_config_file(project, code)
        assert p["list1"]   == "pathogenic.txt"
        assert p["sources"] == "GO:BP KEGG"


