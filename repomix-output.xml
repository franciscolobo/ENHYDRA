        str(tbl2 / "group2anchor.tsv"),
    )

    d = str(workspace / "differential")
    compute_differential(
        tables_dir1=tables_dir,
        tables_dir2=str(tbl2),
        diff_dir=d,
        metric="zscore",
    )
    return d


