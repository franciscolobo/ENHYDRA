        # OG_drop: one outlier, group falls below min_species after pruning.
        _write_fasta(os.path.join(aln, "OG_drop.aln"), [
            ("sp1|g1", "ACGT"), ("sp2|g2", "ACGT"), ("sp3|g3", "ACGT"),
