# --- Input/Output ---
inputdir    = test_data/mammalia/groups
outdir      = validation/mammalia/all_1_1_orthologs
anchor      = Homo_sapiens
max_process = 8

# --- Filtering ---
min_species     = 90        # minimum number of species per orthogroup
min_sequences   = 90         # minimum sequences per group after length filtering
paralogs        = remove       # all | remove | longest
length_filter_sd = 1.2      # sequences beyond mean ± (sd * length_filter_sd) are removed

# --- Alignment ---
aligner     = mafft         # mafft | muscle | prank
mafft_mode  = auto          # auto | linsi | ginsi | einsi | fftnsi | fftns | nwnsi | nwns

# --- Gene set enrichment ---
gene_sets     = test_data/mammalia/GO_annotation/Human_GOALL_with_GO_iea_July_02_2026_symbol.gmt
min_size      = 5
max_size      = 1000
permutations  = 1000
seed          = 42
fdr_threshold = 0.2

# --- Report ---
top_n       = 20            # number of gene sets shown in barplot
obo_cache   = test_data/obo_cache

# --- Two-list differential mode (optional) ---
# list1      = tests/pathogenic_strains.txt
# list2      = tests/non_pathogenic_strains.txt
